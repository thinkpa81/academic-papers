{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "card",
    "request",
    "review"
  ],
  "properties": {
    "card": {
      "type": "object",
      "required": [
        "dataset_id",
        "entity_id",
        "measure_id",
        "model_id",
        "unit",
        "mode",
        "source_sha256",
        "model_sha256",
        "input_sha256",
        "input_ordinal",
        "target_ordinal",
        "step",
        "validation_n",
        "prediction",
        "baseline",
        "delta",
        "intercept",
        "validation_mae",
        "validation_baseline_mae",
        "validation_delta",
        "source_available",
        "historical_vintage_verified",
        "contributions"
      ],
      "properties": {
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "measure_id": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "retrospective",
            "operational"
          ]
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "model_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "target_ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "step": {
          "type": "integer",
          "minimum": 0
        },
        "validation_n": {
          "type": "integer",
          "minimum": 0
        },
        "prediction": {
          "type": "number",
          "minimum": -1e+20,
          "maximum": 1e+20
        },
        "baseline": {
          "type": "number",
          "minimum": -1e+20,
          "maximum": 1e+20
        },
        "delta": {
          "type": "number",
          "minimum": -1e+20,
          "maximum": 1e+20
        },
        "intercept": {
          "type": "number",
          "minimum": -1e+20,
          "maximum": 1e+20
        },
        "validation_mae": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -1e+20,
              "maximum": 1e+20
            },
            {
              "type": "null"
            }
          ]
        },
        "validation_baseline_mae": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -1e+20,
              "maximum": 1e+20
            },
            {
              "type": "null"
            }
          ]
        },
        "validation_delta": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -1e+20,
              "maximum": 1e+20
            },
            {
              "type": "null"
            }
          ]
        },
        "source_available": {
          "type": "boolean"
        },
        "historical_vintage_verified": {
          "type": "boolean"
        },
        "contributions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "minimum": -1e+20,
            "maximum": 1e+20
          }
        }
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": [
        "dataset_id",
        "entity_id",
        "measure_id",
        "model_id",
        "target_ordinal"
      ],
      "properties": {
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "measure_id": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "target_ordinal": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": [
        "evidence_sha256",
        "request_sha256",
        "version",
        "reviewer",
        "reason"
      ],
      "properties": {
        "evidence_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
